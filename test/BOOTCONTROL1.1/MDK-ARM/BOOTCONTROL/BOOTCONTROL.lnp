--cpu=Cortex-M4.fp.sp
"bootcontrol\startup_stm32f407xx.o"
"bootcontrol\main.o"
"bootcontrol\gpio.o"
"bootcontrol\dma.o"
"bootcontrol\usart.o"
"bootcontrol\stm32f4xx_it.o"
"bootcontrol\stm32f4xx_hal_msp.o"
"bootcontrol\stm32f4xx_hal_uart.o"
"bootcontrol\stm32f4xx_hal_rcc.o"
"bootcontrol\stm32f4xx_hal_rcc_ex.o"
"bootcontrol\stm32f4xx_hal_flash.o"
"bootcontrol\stm32f4xx_hal_flash_ex.o"
"bootcontrol\stm32f4xx_hal_flash_ramfunc.o"
"bootcontrol\stm32f4xx_hal_gpio.o"
"bootcontrol\stm32f4xx_hal_dma_ex.o"
"bootcontrol\stm32f4xx_hal_dma.o"
"bootcontrol\stm32f4xx_hal_pwr.o"
"bootcontrol\stm32f4xx_hal_pwr_ex.o"
"bootcontrol\stm32f4xx_hal_cortex.o"
"bootcontrol\stm32f4xx_hal.o"
"bootcontrol\stm32f4xx_hal_exti.o"
"bootcontrol\system_stm32f4xx.o"
"bootcontrol\cmdhandle.o"
"bootcontrol\crc.o"
"bootcontrol\ring.o"
"bootcontrol\unpack.o"
--strict --scatter ".\bootloader.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "BOOTCONTROL.map" -o BOOTCONTROL\BOOTCONTROL.axf